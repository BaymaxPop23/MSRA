# Copy to .env and fill in your values
# Used by Docker Compose and start.sh

# Anthropic API key — required for AI-enhanced scan and PoC generation
ANTHROPIC_API_KEY=sk-ant-...

# Server port (default: 5001)
PORT=5001

# --- Optional: Bedrock-style LLM gateway instead of the direct Anthropic API ---
# MSRA_LLM_BASE_URL=https://llm-gateway.example.com
# MSRA_LLM_TOKEN=
# MSRA_LLM_AUTH_HEADER=Authorization
# Dashboard access control (required if you bind beyond localhost)
# MSRA_AUTH_TOKEN=
